+                        return (
+                          <div key={ws.key} style={{ marginTop: '1px' }}>
+                            <div
+                              className="shlib-wshead"
+                              onClick={() => toggleWorkspace(ws.key)}
+                              title={ws.fullPath ? `${ws.name} (${ws.fullPath})` : ws.name}

+/**
+ * SessionLibrary — dsh-session-hub 侵入补丁（ui-workspace）。
+ *
+ * 在 DSH 侧边栏的"跨工具归档库"区块：按数据来源软件
+ * （opencode / Claude Code / Antigravity / DSH / QoderCN）
+ * 并在每个工具内部进一步按【工作区/项目目录（Workspace）】进行树状折叠与分割。
+ *
+ * 毫秒级极速导入：后端响应后立即跳转，本地即时响应状态，告别轮询卡顿。
+ */
+import { useEffect, useRef, useState, useMemo } from 'react'
+import type { SessionSummary } from '@deepseek-ai/dsh-client-runtime/client'
+import type { WorkspaceBrowserProps } from './contract/slots.ts'
+import rows from './rows/Rows.module.css'
+
+const STYLE = `
+.shlib-root {
+  border-bottom: 1px solid var(--dsw-alias-border-l2, rgba(255, 255, 255, 0.08));
+  padding: 4px 6px 8px;
+  margin-bottom: 6px;
+  box-sizing: border-box;
+  overflow: hidden;
+}
+.shlib-head {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 6px;
+  cursor: pointer;
+  border-radius: 6px;
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: 0.03em;
+  color: var(--dsw-alias-label-tertiary, #81858c);
+  user-select: none;
+  transition: background 150ms, color 150ms;
+}
+.shlib-head:hover {
+  background: var(--dsw-alias-interactive-bg-hover, rgba(255, 255, 255, 0.04));
+  color: var(--dsw-alias-label-primary, #ffffff);
+}
+.shlib-title {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.shlib-count {
+  background: var(--dsw-alias-bg-module-platform, rgba(255, 255, 255, 0.06));
+  border-radius: 10px;
+  padding: 1px 7px;
+  font-size: 10px;
+  font-weight: 500;
+  color: var(--dsw-alias-label-tertiary, #81858c);
+  line-height: 15px;
+  font-variant-numeric: tabular-nums;
+}
+.shlib-body {
+  padding-top: 2px;
+}
+.shlib-src {
+  margin-top: 1px;
+}
+.shlib-srchead {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  padding: 4px 6px;
+  cursor: pointer;
+  border-radius: 6px;
+  font-size: 12px;
+  font-weight: 500;
+  color: var(--dsw-alias-label-secondary, #b4b7bd);
+  user-select: none;
+  transition: background 150ms, color 150ms;
+}
+.shlib-srchead:hover {
+  background: var(--dsw-alias-interactive-bg-hover, rgba(255, 255, 255, 0.04));
+  color: var(--dsw-alias-label-primary, #ffffff);
+}
+.shlib-srcname {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.shlib-srccount {
+  font-size: 10px;
+  color: var(--dsw-alias-label-tertiary, #81858c);
+  font-variant-numeric: tabular-nums;
+}
+.shlib-wshead {
+  display: flex;
+  align-items: center;
+  gap: 5px;
+  padding: 3px 6px 3px 14px;
+  cursor: pointer;
+  border-radius: 5px;
+  font-size: 11px;
+  font-weight: 500;
+  color: var(--dsw-alias-label-tertiary, #9aa0a6);
+  user-select: none;
+  transition: background 150ms, color 150ms;
+  margin-top: 1px;
+}
+.shlib-wshead:hover {
+  background: var(--dsw-alias-interactive-bg-hover, rgba(255, 255, 255, 0.03));
+  color: var(--dsw-alias-label-secondary, #e8eaed);
+}
+.shlib-wsname {
+  flex: 1;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.shlib-wscount {
+  font-size: 10px;
+  color: var(--dsw-alias-label-tertiary, #81858c);
+  font-variant-numeric: tabular-nums;
+  opacity: 0.8;
+}
+.shlib-wslist {
+  padding-left: 10px;
+  margin-top: 1px;
+  box-sizing: border-box;
+}
+.shlib-directlist {
+  padding-left: 12px;
+  margin-top: 1px;
+  box-sizing: border-box;
+}
+.shlib-empty {
+  color: var(--dsw-alias-label-tertiary, #81858c);
+  padding: 4px 10px;
+  font-size: 11px;
+  font-style: italic;
+}
+.shlib-imported-tag {
+  color: #34d399;
+  font-size: 11px;
+  font-weight: bold;
+}
+`
+
+function ChevronIcon({ open, size = 12 }: { open: boolean; size?: number }) {
+  return (
+    <svg
+      width={size}
+      height={size}
+      viewBox="0 0 12 12"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.5"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      style={{
+        transform: open ? 'rotate(90deg)' : 'rotate(0deg)',
+        transition: 'transform 150ms cubic-bezier(0.4, 0, 0.2, 1)',
+        flexShrink: 0,
+      }}
+    >
+      <path d="M4.5 2.5L8 6L4.5 9.5" />
+    </svg>
+  )
+}
+
+function FolderIcon() {
+  return (
+    <svg
+      width="12"
+      height="12"
+      viewBox="0 0 16 16"
+      fill="none"
+      stroke="currentColor"
+      strokeWidth="1.3"
+      strokeLinecap="round"
+      strokeLinejoin="round"
+      style={{ opacity: 0.75, flexShrink: 0 }}
+    >
+      <path d="M2 4.5C2 3.67 2.67 3 3.5 3H6.2C6.6 3 6.98 3.16 7.26 3.44L8.56 4.74C8.84 5.02 9.22 5.18 9.62 5.18H12.5C13.33 5.18 14 5.85 14 6.68V11.5C14 12.33 13.33 13 12.5 13H3.5C2.67 13 2 12.33 2 11.5V4.5Z" />
+    </svg>
+  )
+}
+
+function SourceDot({ color }: { color: string }) {
+  return (
+    <span
+      style={{
+        width: '6px',
+        height: '6px',
+        borderRadius: '50%',
+        backgroundColor: color,
+        flexShrink: 0,
+        boxShadow: `0 0 6px ${color}40`,
+      }}
+    />
+  )
+}
+
+interface LibrarySession {
+  source: string
+  id: string
+  title: string
+  cwd?: string
+  timeUpdated?: number
+  imported?: boolean
+}
+
+interface LibrarySource {
+  source: string
+  sessions: LibrarySession[]
+}
+
+const API = '/session-hub/api'
+
+interface SourceMeta {
+  label: string
+  color: string
+}
+
+const SOURCE_CONFIG: Record<string, SourceMeta> = {
+  opencode: { label: 'OpenCode', color: '#38bdf8' },
+  claude: { label: 'Claude Code', color: '#fb923c' },
+  antigravity: { label: 'Antigravity', color: '#a78bfa' },
+  qodercn: { label: 'QoderCN', color: '#34d399' },
+  dsh: { label: 'DSH 原生', color: '#60a5fa' },
+}
+
+/** 规范化工作区名称显示 */
+function formatWorkspace(cwd?: string): { name: string; fullPath: string } {
+  if (!cwd) return { name: '全局 / 未关联', fullPath: '' }
+  const p = cwd.replace(/\\/g, '/')
+  if (p.includes('/Documents/QoderCN/') || p.includes('/QoderCN/')) {
+    const m = p.match(/QoderCN\/([^/]+)/)
+    if (m && m[1]) {
+      return { name: `QoderCN / ${m[1]}`, fullPath: `~/Documents/QoderCN/${m[1]}` }
+    }
+    return { name: 'QoderCN Workspace', fullPath: p }
+  }
+  const parts = p.split('/').filter(Boolean)
+  if (parts.length === 0) return { name: '~', fullPath: p }
+  const last = parts[parts.length - 1]
+  const prev = parts.length >= 2 ? parts[parts.length - 2] : ''
+  let name = last
+  if (/^chat-\d+$/.test(last) && prev) {
+    name = `${prev}/${last}`
+  }
+  return { name, fullPath: p }
+}
+
+function fmt(ts: number | undefined, now: number, zh: boolean): string {
+  if (!ts) return ''
+  const diff = Math.max(0, now - ts)
+  const MIN = 60_000, HOUR = 3_600_000, DAY = 86_400_000
+  if (diff < MIN) return zh ? '刚刚' : 'now'
+  if (diff < HOUR) { const n = Math.floor(diff / MIN); return zh ? `${n}分钟` : `${n}min` }
+  if (diff < DAY) { const n = Math.floor(diff / HOUR); return zh ? `${n}小时` : `${n}h` }
+  if (diff < 30 * DAY) { const n = Math.floor(diff / DAY); return zh ? `${n}天` : `${n}d` }
+  const d = new Date(ts)
+  return `${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`
+}
+
+export function SessionLibrary({ t, onContinue, useSessions, defaultOpen = false }: {
+  t: WorkspaceBrowserProps['t']
+  onContinue: (sessionId: string) => void
+  useSessions: WorkspaceBrowserProps['useSessions']
+  defaultOpen?: boolean
+}) {
+  const [sources, setSources] = useState<LibrarySource[] | null>(null)
+  const [open, setOpen] = useState(defaultOpen)
+  const [expandedSources, setExpandedSources] = useState<Record<string, boolean>>({})
+  const [expandedWorkspaces, setExpandedWorkspaces] = useState<Record<string, boolean>>({})
+  const [opening, setOpening] = useState<string | null>(null)
+  const [emptyHint, setEmptyHint] = useState<string | null>(null)
+  const byId = useSessions(s => s.byId)
+  const byIdRef = useRef<Record<string, SessionSummary>>({})
+  useEffect(() => { byIdRef.current = byId }, [byId])
+  const now = Date.now()
+
+  const refresh = () => {
+    fetch(`${API}/sources`)
+      .then((r) => r.json())
+      .then((d) => {
+        setSources(d.sources ?? [])
+      })
+      .catch(() => setSources([]))
+  }
+
+  // 首次挂载拉取一次，杜绝无休止死循环轮询
+  useEffect(() => {
+    refresh()
+  }, [])
+
+  const toggleSource = (src: string) => {
+    setExpandedSources((p) => ({ ...p, [src]: !p[src] }))
+  }
+
+  const toggleWorkspace = (wsKey: string) => {
+    setExpandedWorkspaces((p) => ({ ...p, [wsKey]: !p[wsKey] }))
+  }
+
+  // 秒级极速打开
+  const openSession = (s: LibrarySession) => {
+    if (opening !== null) return
+    setOpening(s.id)
+
+    // 1. DSH 原生会话：直接原生打开，0ms 响应，绝不重复克隆
+    if (s.source === 'dsh') {
+      try {
+        onContinue(s.id)
+      } catch (err) {
+        console.warn('open native session failed:', err)
+      }
+      setTimeout(() => setOpening(null), 300)
+      return
+    }
+
+    // 2. 外部会话：调用 continue 接口导入/接续
+    fetch(`${API}/continue`, {
+      method: 'POST',
+      headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ source: s.source, id: s.id }),
+    })
+      .then((r) => r.json())
+      .then((d) => {
+        setOpening(null)
+        if (!(d.ok && d.sessionId)) {
+          if (d.error === 'empty session') {
+            setEmptyHint(s.id)
+            setTimeout(() => setEmptyHint(null), 2500)
+          } else {
+            console.warn('session-hub continue failed:', d)
+          }
+          return
+        }
+        const sid = String(d.sessionId)
+        // 乐观更新
+        setSources(prev => prev ? prev.map(g => g.source === s.source ? {
+          ...g,
+          sessions: g.sessions.map(x => x.id === s.id ? { ...x, imported: true } : x)
+        } : g) : prev)
+        try {
+          onContinue(sid)
+        } catch (err) {
+          console.warn('session-hub: onContinue exception:', err)
+        }
+      })
+      .catch((e) => {
+        console.warn('session-hub: fetch error:', e)
+        setOpening(null)
+      })
+  }
+
+  const zh = t('session.new').includes('新')
+  const total = (sources ?? []).reduce((n, s) => n + s.sessions.length, 0)
+
+  // 聚合成 工具 -> 工作区 -> 会话 结构
+  const structuredSources = useMemo(() => {
+    if (!sources) return []
+    return sources.map((src) => {
+      const wsMap = new Map<string, { key: string; name: string; fullPath: string; sessions: LibrarySession[] }>()
+      for (const s of src.sessions) {
+        const ws = formatWorkspace(s.cwd)
+        const key = `${src.source}::${ws.name}`
+        if (!wsMap.has(key)) {
+          wsMap.set(key, { key, name: ws.name, fullPath: ws.fullPath, sessions: [] })
+        }
+        wsMap.get(key)!.sessions.push(s)

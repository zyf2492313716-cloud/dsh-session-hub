+                              <div className="shlib-wslist">
+                                {ws.sessions.slice(0, 80).map((s) => (
+                                  <SessionRowItem
+                                    key={`${s.source}:${s.id}`}
+                                    s={s}
+                                    cfg={cfg}
+                                    now={now}
+                                    zh={zh}
+                                    opening={opening}
+                                    emptyHint={emptyHint}
+                                    onOpen={openSession}
+                                  />
+                                ))}
+                              </div>
+                            )}
+                          </div>
+                        )
+                      })}
+                    </div>
+                  )}
+                </div>
+              )
+            })}
+          </div>
+        )}
+      </div>
+    </>
+  )
+}
+
+function SessionRowItem({ s, cfg, now, zh, opening, emptyHint, onOpen }: {
+  s: LibrarySession
+  cfg: SourceMeta
+  now: number
+  zh: boolean
+  opening: string | null
+  emptyHint: string | null
+  onOpen: (s: LibrarySession) => void
+}) {
+  const isDsh = s.source === 'dsh'
+  const tooltip = isDsh
+    ? (zh ? 'DSH 本地原生会话，点击直接打开' : 'Native DSH session, click to open')
+    : s.imported
+      ? (zh ? '已导入，点击打开' : 'Imported, click to open')
+      : (zh ? `来自 ${cfg.label}，点击导入并打开` : `From ${cfg.label}, click to import and open`)
+
+  return (
+    <div
+      className={rows.sessionRow}
+      role="treeitem"
+      aria-selected={false}
+      onClick={() => onOpen(s)}
+      title={tooltip}
+    >
+      <span className={rows.slot}>
+        {s.imported ? <span className="shlib-imported-tag">✓</span> : <SourceDot color={cfg.color} />}
+      </span>
+      <span className={rows.title} style={{ maxWidth: '170px' }}>
+        {/^New session - \d{4}-/.test(s.title) ? (zh ? '（无标题）' : '(untitled)') : (s.title || s.id)}
+      </span>
+      <span className={rows.time}>
+        {opening === s.id ? (zh ? '打开中…' : 'opening…')
+          : emptyHint === s.id ? (zh ? '空会话' : 'empty')
+          : isDsh ? fmt(s.timeUpdated, now, zh)
+          : s.imported ? (zh ? '已导入' : 'imported')
+          : fmt(s.timeUpdated, now, zh)}
+      </span>
+    </div>
+  )
+}

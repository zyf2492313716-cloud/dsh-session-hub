{
  "name": "@dsh-local/dsh-session-hub",
  "version": "0.2.0",
  "type": "module",
  "description": "跨工具会话可视化中心：在 DSH Web 浏览/搜索/查看 opencode、Claude Code、Antigravity 与 DSH 会话（浏览搜索只读、无持久索引；导出与接续仅在用户显式操作时写目标工具目录；路由走 DSH 自身的访问准入）",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dsh-session-hub.cordis.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyf2492313716-cloud/dsh-session-hub.git",
    "directory": "plugin"
  },
  "engines": {
    "node": ">=22.15",
    "dsh": ">=0.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "dsh-session-hub.cordis.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.2.1-rc.5": "compatible",
        "0.2.2-alpha.2": "compatible",
        "0.2.2-alpha.3": "compatible",
        "0.2.2-rc.1": "compatible"
      }
    }
  },
  "license": "MIT"
}
